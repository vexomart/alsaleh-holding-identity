<!--[if gte mso 9]><![endif]-->
<title>
	الصفحة غير موجودة
</title></head>
<body>

    <header class="header-wrapper">
        <div class="topbar">
            <div class="container">
                <div class="row">
                    <div class="col-md-6 col-md-push-3 text-center">
                        <a class="logo" href="/">
                            <br>
                            <img src="/ar/PublishingImages/logo.png" alt="" class="logoImg-404">
                        </a>
                    </div>
                   
                </div>
            </div>
        </div>
        
    </header>
    
    <section class="innerpages">
            
            <article class="page-article">
                
                <div class="container">
                    <div class="row">
                        <div class="col-md-8 col-md-push-2">
                            <div class="error-404-wrapper">
                                <div class="hero-msg-404">
                                    <div class="img404 text-center">
                                        <img src="/ar/PublishingImages/img404.svg" alt="">
                                    </div>
                                    <h3 id="pageNotFoundTitle" class="text-center">
                                        الصفحة غير موجودة
                                    </h3>
                                    <p id="sorryParagraph" class="text-center">
                                        عذراً ... الصفحة التي تحاول الوصول إليها غير موجودة 
                                    </p>
                                    <div class="text-center">
                                            <a href="/" id="homepageLink" class="gohome-link">الصفحة الرئيسية</a>
                                    </div>
                                    

                                </div>

                            </div>
                        </div>
                    </div>
                    
                </div>
            </article>
    </section>
    <footer>
            <div class="container">
                
                <div class="row">
                        <div class="col-xs-12">
                            <div class="copyRights-404 text-center">
                                    جميع الحقوق محفوظة © 2020 لوزارة التجارة
                            </div>
                        </div>
                        
                    </div>
            </div>
            
    </footer>
    
    <script type="text/javascript">
    $(document).ready(function () {

        var requestUrl= getParameterByName('requestUrl');
        if (requestUrl.toLowerCase().indexOf('/en/')>-1) {

			$('.copyRights-404').html('Copyright © 2019 Ministry of Commerce and Investment');

			$('#homepageLink').html('Home Page');
			
    		$('#homepageLink').attr('href','/en');
    		
    		$('#sorryParagraph').html('Sorry ... The page you are trying to access does not exist');
    		
    			$('#pageNotFoundTitle').html('Page Not Found');
			
        }
    });


    function getParameterByName(name, url) {
        if (!url) url = window.location.href;
        name = name.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
            results = regex.exec(url);
        if (!results) return null;
        if (!results[2]) return '';
        return decodeURIComponent(results[2].replace(/\+/g, ' '));
    }
    
</script>
</body>
</html>
